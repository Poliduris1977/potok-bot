# .env.example — скопируй в .env и заполни
# cp .env.example .env

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Макс (подключить после стабильного Telegram) ──────────────────────────────
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# ── GigaChat ──────────────────────────────────────────────────────────────────
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Для теста (физлицо):  GIGACHAT_API_PERS
# Для прода  (юрлицо):  GIGACHAT_API_B2B
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ── База данных ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://potok:secret@db:5432/potokbot

# ── Уведомления ───────────────────────────────────────────────────────────────
# Числовой Telegram ID директора (узнать через @userinfobot)
DIRECTOR_CHAT_ID=

# ── Деплой ────────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://yourdomain.com
ENVIRONMENT=development

# ── Бот ───────────────────────────────────────────────────────────────────────
BOT_NAME=Алина
COMPANY_NAME=КухниПроект
