# ══════════════════════════════════════════
#  ПОТОК — .gitignore
# ══════════════════════════════════════════

# ── Секреты — НИКОГДА не коммитить ────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ── Виртуальное окружение ──────────────────
venv/
.venv/
env/

# ── Python ────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ── Docker ────────────────────────────────
*.log
docker-compose.override.yml

# ── IDE ───────────────────────────────────
.vscode/
.idea/
*.swp

# ── OS ────────────────────────────────────
.DS_Store
Thumbs.db

# ── Тестовые скрипты ──────────────────────
test_*.py

# ── Старые спринты ────────────────────────
potok_sprint0/

# ── Временные файлы ───────────────────────
*.tmp
*.bak